# Sarvam configuration for Virasat Saathi.
# Keep the real key out of git. Copy this file to .env and paste your key there.
SARVAM_API_KEY=
SARVAM_ENABLED=true

# Phase 2 - Sarvam Document AI Extract (external policy documents)
SARVAM_DOCUMENT_LANGUAGE=en-IN
SARVAM_JOB_TIMEOUT_SECONDS=120
# Optional: polling interval for the asynchronous Extract job.
# SARVAM_POLL_INTERVAL_SECONDS=3

# Phase 1 - optional fictional-content paraphrase (chat-completions)
SARVAM_MODEL=gemma4
SARVAM_BASE_URL=https://api.sarvam.ai/v2
SARVAM_TIMEOUT_SECONDS=8
SARVAM_MAX_OUTPUT_TOKENS=180
